# PostgreSQL 15+ (Neon, local Docker or compatible service)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require"
# Recomendado: una rama Neon exclusiva para Playwright. Si se omite, usa DATABASE_URL.
E2E_DATABASE_URL=
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-random-characters"
# HMAC pepper independiente para los códigos OTP. Generate with: openssl rand -base64 48
EMAIL_OTP_SECRET="replace-with-an-independent-random-secret"
# Independiente del OTP de verificación. Generate with: openssl rand -base64 48
PASSWORD_RESET_SECRET="replace-with-an-independent-random-secret"
APP_URL=https://www.miboletin.lat
# Protects the ingestion HTTP endpoint used by an external cron or worker
CRON_SECRET="replace-with-an-independent-random-secret"

# Stripe Billing (plan recurrente de $499 MXN/mes)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Correos transaccionales. El remitente debe estar verificado en Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=avisos@example.com
BREVO_SENDER_NAME=Mi Boletín Judicial

# Asistente mediante un gateway compatible con la API de OpenAI.
# Sólo servidor: nunca uses el prefijo NEXT_PUBLIC_ para estas variables.
AI_API_KEY=
AI_BASE_URL=https://tokease.com/v1
# Los identificadores exactos se administran en el entorno, no en el código.
AI_MODEL_FAST=
AI_MODEL_PRO=
AI_MODEL_PREMIUM=
# Opcional: JSON por modelo con inputUsdPerMillion/outputUsdPerMillion.
AI_MODEL_PRICING_JSON=
# Compatibilidad temporal con despliegues anteriores; migra a AI_*.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Provider controls
JALISCO_API_BASE=https://api.cjj.gob.mx
SOURCE_USER_AGENT=MiBoletinJudicial/1.0 (+https://miboletin.lat)
FEDERAL_SESSION_BASE=https://www.dgej.cjf.gob.mx/SiseInternet

# Almacenamiento privado de sentencias. Vercel la agrega al conectar un Blob privado.
BLOB_READ_WRITE_TOKEN=
# Opcional en localhost; por defecto usa .data/judicial-documents.
JUDICIAL_DOCUMENTS_DIR=

# Sólo para crear una cuenta inicial con pnpm db:seed. No hay credenciales predeterminadas.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrador
SEED_ORGANIZATION_NAME=Mi organización
